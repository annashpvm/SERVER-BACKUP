                        <value>Grpagent</value>
                    </simple-property-list>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["invh_netamt"]</expression>
                        </structure>
                    </list-property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">invh_our_ordno</property>
                    <text-property name="displayName">invh_our_ordno</text-property>
                    <expression name="expression" type="javascript">dataSetRow["invh_our_ordno"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">Column Binding</property>
                    <expression name="expression" type="javascript">if (dataSetRow["var_size1"] > 0)
Formatter.format(dataSetRow["var_size1"],"#0.0") + " X " + Formatter.format(dataSetRow["var_size2"],"#0.0")
else
Formatter.format(dataSetRow["var_size2"],"#0.0")</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">size</property>
                    <text-property name="displayName">size</text-property>
                    <expression name="expression" type="javascript">if (dataSetRow["var_size1"] > 0)
Formatter.format(dataSetRow["var_size1"],"#0.0") + " X " + Formatter.format(dataSetRow["var_size2"],"#0.0")
else
Formatter.format(dataSetRow["var_size2"],"#0.0")</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">disc</property>
                    <text-property name="displayName">disc</text-property>
                    <expression name="expression" type="javascript">Formatter.format(dataSetRow["invt_amt"]-dataSetRow["invt_value"],"#")</expression>
                    <property name="dataType">decimal</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">gst</property>
                    <text-property name="displayName">gst</text-property>
                    <expression name="expression" type="javascript">dataSetRow["invh_cgst_amt"]+dataSetRow["invh_igst_amt"]+dataSetRow["invh_sgst_amt"]</expression>
                    <property name="dataType">decimal</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">nmr</property>
                    <text-property name="displayName">nmr</text-property>
                    <expression name="expression" type="javascript">dataSetRow["invt_urate"]-(dataSetRow["invh_comm"]+dataSetRow["invt_cashdis_pmt"]+dataSetRow["invt_dealerdis_pmt"]+dataSetRow["invt_reeldis_pmt"]+dataSetRow["invt_regdis_pmt"]+dataSetRow["invt_addnldis_pmt"])</expression>
                    <property name="dataType">decimal</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">wt</property>
                    <text-property name="displayName">wt</text-property>
                    <expression name="expression" type="javascript">dataSetRow["invt_wt"]/1000</expression>
                    <property name="dataType">decimal</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">Rundate</property>
                    <text-property name="displayName">Rundate</text-property>
                    <expression name="expression" type="javascript">Formatter.format(new Date(),"dd/MM/yyyy")</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
            </list-property>
