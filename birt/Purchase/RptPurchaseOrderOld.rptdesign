                    <expression name="expression" type="javascript">Formatter.format((dataSetRow["ptr_ord_qty"]*dataSetRow["ptr_unit_rate"]),"0.00") - row["disc"] + row["pfval"] + dataSetRow["ptr_oth_amt"] + dataSetRow["ptr_freight_amt"] + dataSetRow["ptr_cgst_amt"] + dataSetRow["ptr_sgst_amt"]+ dataSetRow["ptr_igst_amt"]</expression>
                    <property name="dataType">float</property>
                    <property name="allowExport">true</property>
                </structure>
