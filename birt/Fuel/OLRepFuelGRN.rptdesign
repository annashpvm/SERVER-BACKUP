if (vars["no1"]==1) 
vars["remarks"]=vars["no1"]+'.'+row["rect_remarks"];
else
if ((BirtStr.charLength(vars["remarks"])+BirtStr.charLength(row["rect_remarks"]))>245 || vars["rem1"]!='') 
vars["rem1"]=vars["rem1"]+""+vars["no1"]+'.'+row["rect_remarks"];
else
vars["remarks"]=BirtStr.left(vars["remarks"]+""+vars["no1"]+'.'+row["rect_remarks"],250);
