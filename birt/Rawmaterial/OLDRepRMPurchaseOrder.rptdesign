    <body>
        <table id="93">
            <property name="height">20.5cm</property>
            <property name="width">28.3cm</property>
            <property name="dataSet">DSRMPO</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">itmh_hsncode</property>
                    <text-property name="displayName">itmh_hsncode</text-property>
                    <expression name="expression" type="javascript">dataSetRow["itmh_hsncode"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">itmh_name</property>
                    <text-property name="displayName">itmh_name</text-property>
                    <expression name="expression" type="javascript">dataSetRow["itmh_name"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ordt_qty</property>
                    <text-property name="displayName">ordt_qty</text-property>
                    <expression name="expression" type="javascript">dataSetRow["ordt_qty"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">ordt_unit_rate</property>
                    <text-property name="displayName">ordt_unit_rate</text-property>
                    <expression name="expression" type="javascript">dataSetRow["ordt_unit_rate"]</expression>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">ordh_cgstper</property>
                    <text-property name="displayName">ordh_cgstper</text-property>
                    <expression name="expression" type="javascript">dataSetRow["ordh_cgstper"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">item</property>
                    <text-property name="displayName">item</text-property>
                    <expression name="expression" type="javascript">dataSetRow["ordt_qty"]*dataSetRow["ordt_unit_rate"]</expression>
                    <property name="dataType">float</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">cgstamt</property>
                    <text-property name="displayName">cgstamt</text-property>
                    <expression name="expression" type="javascript">Formatter.format((row["item"]*dataSetRow["ordh_cgstper"])/100,"0")</expression>
                    <property name="dataType">float</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">ordh_sgstper</property>
                    <text-property name="displayName">ordh_sgstper</text-property>
                    <expression name="expression" type="javascript">dataSetRow["ordh_sgstper"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">sgstamt</property>
                    <text-property name="displayName">sgstamt</text-property>
                    <expression name="expression" type="javascript">Formatter.format((row["item"]*dataSetRow["ordh_sgstper"])/100,"0");</expression>
                    <property name="dataType">float</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">ordh_igstper</property>
                    <text-property name="displayName">ordh_igstper</text-property>
                    <expression name="expression" type="javascript">dataSetRow["ordh_igstper"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">igstamt</property>
                    <text-property name="displayName">igstamt</text-property>
                    <expression name="expression" type="javascript">Formatter.format((row["item"]*dataSetRow["ordh_igstper"])/100,"0");</expression>
                    <property name="dataType">float</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">itemval</property>
                    <text-property name="displayName">itemval</text-property>
                    <expression name="expression" type="javascript">Formatter.format((row["item"]+row["cgstamt"]+row["sgstamt"]+row["igstamt"]),"0");</expression>
                    <property name="dataType">float</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">ordh_no</property>
