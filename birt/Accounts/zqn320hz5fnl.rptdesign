            <xml-property name="queryText"><![CDATA[select CLASSICMODELS.PAYMENTS.CUSTOMERNUMBER,CLASSICMODELS.PAYMENTS.PAYMENTDATE,CLASSICMODELS.PAYMENTS.AMOUNT, 
CLASSICMODELS.CUSTOMERS.CUSTOMERNAME,CLASSICMODELS.CUSTOMERS.COUNTRY, CLASSICMODELS.CUSTOMERS.STATE
from CLASSICMODELS.CUSTOMERS
inner join CLASSICMODELS.PAYMENTS on CLASSICMODELS.CUSTOMERS.CUSTOMERNUMBER = CLASSICMODELS.PAYMENTS.CUSTOMERNUMBER
where CLASSICMODELS.CUSTOMERS.COUNTRY in ('USA', 'Canada', 'Japan')]]></xml-property>
