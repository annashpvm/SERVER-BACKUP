            <list-property name="computedColumns">
                <structure>
                    <property name="name">c1</property>
                    <expression name="expression">if (params["d1"].value == 1) {&#13;
    BirtDateTime.day(row["PAYMENTDATE"]);&#13;
} else if (params["d1"].value == 2) {&#13;
   BirtDateTime.month(row["PAYMENTDATE"]);&#13;
} else {&#13;
   BirtDateTime.year(row["PAYMENTDATE"]);&#13;
}</expression>
                    <property name="dataType">integer</property>
                </structure>
            </list-property>
