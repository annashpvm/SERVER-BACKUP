    <body>
        <table id="455">
            <property name="dataSet">vouprint</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">accref_voudate</property>
                    <text-property name="displayName">accref_voudate</text-property>
                    <expression name="expression" type="javascript">dataSetRow["accref_voudate"]</expression>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="name">accref_vouno</property>
                    <text-property name="displayName">accref_vouno</text-property>
                    <expression name="expression" type="javascript">dataSetRow["accref_vouno"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">ledgername</property>
                    <text-property name="displayName">ledgername</text-property>
                    <expression name="expression" type="javascript">dataSetRow["ledgername"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">acctran_dbamt</property>
                    <text-property name="displayName">acctran_dbamt</text-property>
                    <expression name="expression" type="javascript">dataSetRow["acctran_dbamt"]</expression>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">acctran_cramt</property>
                    <text-property name="displayName">acctran_cramt</text-property>
                    <expression name="expression" type="javascript">dataSetRow["acctran_cramt"]</expression>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">acctran_serialno</property>
                    <text-property name="displayName">acctran_serialno</text-property>
                    <expression name="expression" type="javascript">dataSetRow["acctran_serialno"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">accref_payref_no</property>
                    <text-property name="displayName">accref_payref_no</text-property>
                    <expression name="expression" type="javascript">dataSetRow["accref_payref_no"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">refno</property>
                    <expression name="expression" type="javascript">var mode = dataSetRow["accref_paymode"] == null ? "" : dataSetRow["accref_paymode"];&#13;
var ref  = dataSetRow["accref_payref_no"] == null ? "" : dataSetRow["accref_payref_no"];&#13;
&#13;
(&#13;
 ['REC','PAY','CHR','CHP','BKR','BKP'].indexOf(params["voutype"].value) >= 0&#13;
)&#13;
?&#13;
(mode + (ref == "" ? "" : " " + ref))&#13;
:&#13;
(&#13;
    (ref != "" &amp;&amp;&#13;
     dataSetRow["accref_vouno"] != null &amp;&amp;&#13;
     dataSetRow["cust_type"] != null &amp;&amp;&#13;
     ref.toString().replace(/^\s+|\s+$/g,"") != &#13;
     dataSetRow["accref_vouno"].toString().replace(/^\s+|\s+$/g,"") &amp;&amp;&#13;
     dataSetRow["cust_type"].toString().replace(/^\s+|\s+$/g,"") != "G"&#13;
    )&#13;
    ? ref&#13;
    : ""&#13;
)</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">cust_type</property>
                    <text-property name="displayName">cust_type</text-property>
                    <expression name="expression" type="javascript">dataSetRow["cust_type"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">adjinvno</property>
                    <text-property name="displayName">adjinvno</text-property>
                    <expression name="expression" type="javascript">dataSetRow["adjinvno"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">adjinvdate</property>
                    <text-property name="displayName">adjinvdate</text-property>
                    <expression name="expression" type="javascript">dataSetRow["adjinvdate"]</expression>
                    <property name="dataType">date</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">adjamt</property>
                    <text-property name="displayName">adjamt</text-property>
                    <expression name="expression" type="javascript">dataSetRow["adjamt"]</expression>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="name">accref_narration</property>
                    <text-property name="displayName">accref_narration</text-property>
                    <expression name="expression" type="javascript">dataSetRow["accref_narration"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">rundate</property>
                    <expression name="expression" type="javascript">Formatter.format(BirtDateTime.today(),"dd/MM/yyyy")</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">sum_debit</property>
                    <property name="dataType">float</property>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["debit"]</expression>
                        </structure>
                    </list-property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">sum_credit</property>
                    <property name="dataType">float</property>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["credit"]</expression>
                        </structure>
                    </list-property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">heading</property>
                    <text-property name="displayName">heading</text-property>
                    <expression name="expression" type="javascript">var vt = params["voutype"].value;&#13;
&#13;
/* EXP / GJV */&#13;
if (vt == "EXP")&#13;
"EXPENSES REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
&#13;
else if (vt == "GJV")&#13;
"JOURNAL REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
&#13;
/* BANK (specific first) */&#13;
else if (vt.indexOf("BKP") >= 0 &amp;&amp; vt.indexOf(",") == -1)&#13;
"BANK PAYMENT REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
&#13;
else if (vt.indexOf("BKR") >= 0 &amp;&amp; vt.indexOf(",") == -1)&#13;
"BANK RECEIPT REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
&#13;
/* GROUP TYPES */&#13;
else if (vt == "PAY" || vt.indexOf("BKP") >= 0 || vt.indexOf("CHP") >= 0 || vt.indexOf("CIP") >= 0)&#13;
"PAYMENT REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
&#13;
else if (vt == "REC" || vt.indexOf("BKR") >= 0 || vt.indexOf("CHR") >= 0 || vt.indexOf("CIR") >= 0)&#13;
"RECEIPT REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
&#13;
/* NOTES */&#13;
else if (vt == "DNOTE" || vt.indexOf("DNG") >= 0 || vt.indexOf("DNN") >= 0 || vt.indexOf("SDN") >= 0)&#13;
"DEBIT NOTE REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
&#13;
else if (vt == "CNOTE" || vt.indexOf("CNG") >= 0 || vt.indexOf("CNN") >= 0)&#13;
"CREDIT NOTE REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
&#13;
/* OTHERS */&#13;
else if (vt == "GSI")&#13;
"SALES REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
&#13;
else if (vt == "OSI")&#13;
"OTHER SALES REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
&#13;
else if (vt == "PUR")&#13;
"ALL PURCHASES REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
&#13;
else&#13;
"REGISTER " + BirtStr.concat("From ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy")," To ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">debit_total</property>
                    <expression name="expression" type="javascript">Total.sum(row["acctran_dbamt"])</expression>
                    <property name="dataType">float</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">debit</property>
                    <property name="dataType">float</property>
                    <simple-property-list name="aggregateOn">
                        <value>slnogrp</value>
                    </simple-property-list>
                    <property name="aggregateFunction">MAX</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["acctran_dbamt"]</expression>
                        </structure>
                    </list-property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">credit</property>
                    <property name="dataType">float</property>
                    <simple-property-list name="aggregateOn">
                        <value>slnogrp</value>
                    </simple-property-list>
                    <property name="aggregateFunction">MAX</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["acctran_cramt"]</expression>
                        </structure>
                    </list-property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
