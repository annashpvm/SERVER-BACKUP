                </structure>
                <structure>
                    <property name="name">heading</property>
                    <text-property name="displayName">heading</text-property>
                    <expression name="expression" type="javascript">"Billwise Outstanding For the Period " + BirtStr.concat("From ",Formatter.format(params["fromdate"].value,"dd/MM/yyyy"),"  To  ",Formatter.format(params["todate"].value,"dd/MM/yyyy"))</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">rundate</property>
                    <text-property name="displayName">rundate</text-property>
                    <expression name="expression" type="javascript">Formatter.format(BirtDateTime.today(),"dd/MM/yyyy")</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">sum_invvalue</property>
                    <text-property name="displayName">sum_invvalue</text-property>
                    <property name="dataType">float</property>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
