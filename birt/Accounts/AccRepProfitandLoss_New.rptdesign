                <structure>
                    <property name="name">ledgerClosing</property>
                    <expression name="expression" type="javascript">var columnvalue= row["closingvalue"], customformat="##,##,##,##,##0.00"; //we can add here a test for conditional formatting&#13;
if (columnvalue!= 0){&#13;
  var symbols=Packages.com.ibm.icu.text.DecimalFormatSymbols(new Packages.java.util.Locale("en","IN"));&#13;
  var formatter=Packages.com.ibm.icu.text.DecimalFormat(customformat,symbols);&#13;
  var value=new Packages.java.math.BigDecimal(columnvalue.toString());&#13;
formatter.format(value);&#13;
}</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">sum_closingvalue</property>
                    <property name="dataType">float</property>
                    <simple-property-list name="aggregateOn">
