    <body>
        <table id="693">
            <property name="width">7.489583333333333in</property>
            <property name="dataSet">Data Set</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">accref_voudate</property>
                    <text-property name="displayName">accref_voudate</text-property>
                    <expression name="expression" type="javascript">dataSetRow["accref_voudate"]</expression>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="name">cust_name</property>
                    <text-property name="displayName">cust_name</text-property>
                    <expression name="expression" type="javascript">dataSetRow["cust_name"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">accref_vouno</property>
                    <text-property name="displayName">accref_vouno</text-property>
                    <expression name="expression" type="javascript">dataSetRow["accref_vouno"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">vouno</property>
                    <expression name="expression" type="javascript">if (dataSetRow["accref_vou_type"] == "GSI" || dataSetRow["accref_vou_type"] == "OSI" || dataSetRow["accref_vou_type"] == "CNG" || dataSetRow["accref_vou_type"] == "CNN")&#13;
    dataSetRow["accref_vouno"]&#13;
else&#13;
   dataSetRow["accref_payref_no"]</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">acctran_dbamt</property>
                    <text-property name="displayName">acctran_dbamt</text-property>
                    <expression name="expression" type="javascript">dataSetRow["acctran_dbamt"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">acctran_cramt</property>
                    <text-property name="displayName">acctran_cramt</text-property>
                    <expression name="expression" type="javascript">dataSetRow["acctran_cramt"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">rundate</property>
                    <expression name="expression" type="javascript">Formatter.format(BirtDateTime.today(),"dd/MM/yyyy")</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">heading</property>
                    <expression name="expression" type="javascript">params["ledname"].value + " - Ledger Details From " +&#13;
Formatter.format(params["fromdate"].value, "dd/MM/yyyy") + &#13;
" To " + &#13;
Formatter.format(params["todate"].value, "dd/MM/yyyy")</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">accref_narration</property>
                    <text-property name="displayName">accref_narration</text-property>
                    <expression name="expression" type="javascript">dataSetRow["accref_narration"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">voutype</property>
                    <expression name="expression" type="javascript">if (dataSetRow["accref_vou_type"] == "GSI")&#13;
   "Sales"&#13;
else if (dataSetRow["accref_vou_type"] == "GJV")&#13;
   "Journal"&#13;
else if (dataSetRow["accref_vou_type"] == "DNG" || dataSetRow["accref_vou_type"] == "DNN" )&#13;
   "Debit Note"&#13;
else if (dataSetRow["accref_vou_type"] == "CNG" || dataSetRow["accref_vou_type"] == "CNN" )&#13;
   "Credit Note"&#13;
else if (dataSetRow["accref_vou_type"] == "OSI")&#13;
   "Other Sales"&#13;
else if (dataSetRow["accref_vou_type"] == "CIP")&#13;
   "Cash Payment"&#13;
else if (dataSetRow["accref_vou_type"] == "CIR")&#13;
   "Cash Receipt"&#13;
else if (dataSetRow["accref_vou_type"] == "BKP")&#13;
   "Bank Payment"&#13;
else if (dataSetRow["accref_vou_type"] == "BKR")&#13;
   "Bank Receipt"&#13;
else if (dataSetRow["accref_vou_type"] == "PIW" || dataSetRow["accref_vou_type"] == "PWP"  || dataSetRow["accref_vou_type"] == "PGS" || dataSetRow["accref_vou_type"] == "PFU")&#13;
   "Purchases"</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">voudate</property>
                    <expression name="expression" type="javascript">if (dataSetRow["accref_vou_type"] == "GSI" || dataSetRow["accref_vou_type"] == "OSI" || dataSetRow["accref_vou_type"] == "CNG" || dataSetRow["accref_vou_type"] == "CNN")&#13;
   dataSetRow["accref_voudate"]&#13;
else&#13;
   dataSetRow["accref_payref_date"]</expression>
                    <property name="dataType">date</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">debit</property>
                    <expression name="expression" type="javascript">var columnvalue= row["acctran_dbamt"], customformat="##,##,##,##,##0.00"; //we can add here a test for conditional formatting&#13;
if (columnvalue!= 0){&#13;
  var symbols=Packages.com.ibm.icu.text.DecimalFormatSymbols(new Packages.java.util.Locale("en","IN"));&#13;
  var formatter=Packages.com.ibm.icu.text.DecimalFormat(customformat,symbols);&#13;
  var value=new Packages.java.math.BigDecimal(columnvalue.toString());&#13;
formatter.format(value);&#13;
}</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">credit</property>
                    <expression name="expression" type="javascript">var columnvalue= dataSetRow["acctran_cramt"], customformat="##,##,##,##,##0.00"; //we can add here a test for conditional formatting&#13;
if (columnvalue!= 0){&#13;
  var symbols=Packages.com.ibm.icu.text.DecimalFormatSymbols(new Packages.java.util.Locale("en","IN"));&#13;
  var formatter=Packages.com.ibm.icu.text.DecimalFormat(customformat,symbols);&#13;
  var value=new Packages.java.math.BigDecimal(columnvalue.toString());&#13;
formatter.format(value);&#13;
}</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
