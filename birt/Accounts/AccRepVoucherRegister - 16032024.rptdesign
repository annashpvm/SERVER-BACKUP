                <structure>
                    <property name="name">rundate</property>
                    <text-property name="displayName">rundate</text-property>
                    <expression name="expression" type="javascript">Formatter.format(BirtDateTime.today(),"dd/MM/yyyy")</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">MillName</property>
                    <expression name="expression" type="javascript">if(params["comp"].value == 1)&#13;
"SRI HARI VENKATESWARA PAPER MILLS (P) LTD"&#13;
else if (params["comp"].value == 90)&#13;
"TRIAL STORE"</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">heading</property>
                    <text-property name="displayName">heading</text-property>
                    <expression name="expression" type="javascript">if (params["voutype"].value=="EXP")&#13;
"EXPENSES REGISTER " + BirtStr.concat("From Date : ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy"),"  To Date : ",Formatter.format(params["tdate"].value,"dd/MM/yyyy")) &#13;
else if (params["voutype"].value=="GJV")&#13;
"JOURNAL REGISTER " + BirtStr.concat("From Date : ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy"),"  To Date : ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
else if (params["voutype"].value=="DNG")&#13;
"DEBIT NOTE REGISTER "  + BirtStr.concat("From Date : ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy"),"  To Date : ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
else if (params["voutype"].value=="CNG")&#13;
"CREDIT NOTE REGISTER "  + BirtStr.concat("From Date : ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy"),"  To Date : ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
else if (params["voutype"].value=="GSI")&#13;
"SALES REGISTER "  + BirtStr.concat("From Date : ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy"),"  To Date : ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))&#13;
else if (params["voutype"].value=="OSI")&#13;
"OTHER SALES REGISTER "  + BirtStr.concat("From Date : ",Formatter.format(params["fmdate"].value,"dd/MM/yyyy"),"  To Date : ",Formatter.format(params["tdate"].value,"dd/MM/yyyy"))</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
