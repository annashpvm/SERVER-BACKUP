                </structure>
                <structure>
                    <property name="name">REF</property>
                    <text-property name="displayName">REF</text-property>
                    <expression name="expression" type="javascript">BirtStr.concat('Description: ',dataSetRow["accref_narration"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">acctrail_inv_date</property>
                    <text-property name="displayName">acctrail_inv_date</text-property>
                    <expression name="expression" type="javascript">dataSetRow["acctrail_inv_date"]</expression>
                    <property name="dataType">date</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">acctrail_inv_no</property>
                    <text-property name="displayName">acctrail_inv_no</text-property>
                    <expression name="expression" type="javascript">dataSetRow["acctrail_inv_no"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">accref_vou_type</property>
                    <text-property name="displayName">accref_vou_type</text-property>
                    <expression name="expression" type="javascript">dataSetRow["accref_vou_type"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">voutype</property>
                    <expression name="expression" type="javascript">if (dataSetRow["accref_vou_type"] == 'DNG')&#13;
   "DEBIT NOTE(GST)"&#13;
else if (dataSetRow["accref_vou_type"] == 'DNN')   &#13;
   "DEBIT NOTE"&#13;
else if (dataSetRow["accref_vou_type"] == 'CNG')   &#13;
   "CREDIT NOTE(GST)"   &#13;
else if (dataSetRow["accref_vou_type"] == 'CNN')   &#13;
   "CREDIT NOTE"&#13;
else if (dataSetRow["accref_vou_type"] == 'CIR' || dataSetRow["accref_vou_type"] == 'BKR')   &#13;
   "RECEIPT"&#13;
else if (dataSetRow["accref_vou_type"] == 'CIR' || dataSetRow["accref_vou_type"] == 'BKP')   &#13;
   "PAYMENT"</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">cust_name</property>
                    <text-property name="displayName">cust_name</text-property>
                    <expression name="expression" type="javascript">dataSetRow["cust_name"]</expression>
                    <property name="dataType">string</property>
                </structure>
