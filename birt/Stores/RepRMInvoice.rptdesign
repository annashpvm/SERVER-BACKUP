                </structure>
                <structure>
                    <property name="name">testval</property>
                    <text-property name="displayName">insval</text-property>
                    <expression name="expression" type="javascript">vars["insno"];
vars["insp"];
var rej_qty;
var shr_qty;
var ex_mois;
var deg_qty;
var tar_qty;
var lif_qty;
var rec_qty=0;
var ex_moisper=0;
var linsno = 1;
var linsp ="";
if ( vars["insno"] &lt; 1)
vars["insno"]= 1;

//Received Qty
if  ( dataSetRow["rect_millqty"]>0)
rec_qty=dataSetRow["rect_millqty"]-dataSetRow["rect_degqty"];
else
rec_qty=dataSetRow["rect_grnqty"];
//Rejected Qty
if ( dataSetRow["rect_rejqty"]=0 )
rej_qty='';
else
rej_qty=BirtStr.concat('| REJ QTY  :'+Formatter.format(dataSetRow["rect_rejqty"],"0.000")+' M.T');
//Shortage qty
if ( dataSetRow["rect_billqty"]-dataSetRow["rect_millqty"]>0 )
shr_qty=BirtStr.concat('| Shortage Qty :'+Formatter.format(dataSetRow["rect_billqty"]-dataSetRow["rect_millqty"],"0.000")+' Tons');
else
shr_qty='';
//EX.Moisture qtt
//Calculating Exmoisture %
if ( (dataSetRow["rect_millqty"]-dataSetRow["rect_lifelessqty"]-dataSetRow["rect_rejqty"]-dataSetRow["rect_tareqty"]) != 0 )
ex_moisper=(dataSetRow["rect_moisqty"]/(dataSetRow["rect_millqty"]-dataSetRow["rect_lifelessqty"]-dataSetRow["rect_rejqty"]-dataSetRow["rect_tareqty"]))*100;
else
0;
//if dataSetRow["ordt_moisper"]&lt;dataSetRow["rect_moisper"] )
//ex_moisper=dataSetRow["rect_moisper"]-dataSetRow["ordt_moisper"];
//else
//ex_moisper=0;
if  ( dataSetRow["rect_moisqty"]>0 )
ex_mois='| Ex.Mois :'+Formatter.format(ex_moisper,"0.00") +' %'+ ' Qty : '+Formatter.format(dataSetRow["rect_moisqty"],"0.000") +' M.T';
else
ex_mois='';
//Calculating Degrade Qty
if  ( dataSetRow["rect_degqty"]>0 )
deg_qty='| Deg.Qty  :'+Formatter.format(dataSetRow["rect_degqty"],"0.000") +' M.T';
else
deg_qty='';
//Calculating Tare Qty
if  ( dataSetRow["rect_tareqty"]>0 )
tar_qty='| Tare.Qty  :'+Formatter.format(dataSetRow["rect_tareqty"],"0.000")+' M.T';
else
tar_qty='';

//Calulating Life less qty
if  ( dataSetRow["rect_lifelessqty"]>0 )
lif_qty=' | Life.l Qty '+Formatter.format(dataSetRow["rect_lifelessqty"],"0.000")+' M.T';
else
lif_qty='';

if  ( vars["insno"]==1 )
vars["insp"]=vars["insp"]+vars["insno"]+'.'+'Recd Qty :'+Formatter.format(rec_qty,"0.000")+shr_qty+ex_mois+deg_qty+rej_qty+tar_qty+lif_qty;
else
vars["insp"]=vars["insp"]+"\n"+vars["insno"]+'.'+'Recd Qty :'+Formatter.format(rec_qty,"0.000")+shr_qty+ex_mois+deg_qty+rej_qty+tar_qty+lif_qty;
vars["insno"]=vars["insno"]+1;
vars["insp"];</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
