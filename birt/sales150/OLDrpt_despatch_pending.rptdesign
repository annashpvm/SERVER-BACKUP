    <body>
        <table id="351">
            <property name="dataSet">desp_pending</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">ordh_sono</property>
                    <text-property name="displayName">ordh_sono</text-property>
                    <expression name="expression" type="javascript">dataSetRow["ordh_sono"]</expression>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="name">ordh_sodate</property>
                    <text-property name="displayName">ordh_sodate</text-property>
                    <expression name="expression" type="javascript">dataSetRow["ordh_sodate"]</expression>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="name">stk_ent_date</property>
                    <text-property name="displayName">stk_ent_date</text-property>
                    <expression name="expression" type="javascript">dataSetRow["stk_ent_date"]</expression>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="name">stk_sr_no</property>
                    <text-property name="displayName">stk_sr_no</text-property>
                    <expression name="expression" type="javascript">dataSetRow["stk_sr_no"]</expression>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="name">weight</property>
                    <text-property name="displayName">weight</text-property>
                    <expression name="expression" type="javascript">Formatter.format(dataSetRow["stk_wt"] / 1000,"0.000")</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">var_name</property>
                    <text-property name="displayName">var_name</text-property>
                    <expression name="expression" type="javascript">dataSetRow["var_name"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">variety_detail</property>
                    <text-property name="displayName">variety_detail</text-property>
                    <expression name="expression" type="javascript">dataSetRow["vargrp_type_name"] +  " - " + dataSetRow["var_bf"] +  "  BF " + dataSetRow["var_gsm"] + " GSM  - " + row["shade"] +  " -  " + row["size"]</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">shade</property>
                    <expression name="expression" type="javascript">if (dataSetRow["var_shade"] == "N")&#13;
{&#13;
   "NAT"&#13;
 }&#13;
else&#13;
{&#13;
   "OTH"&#13;
}</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">size</property>
                    <expression name="expression" type="javascript">if (dataSetRow["var_inchcm"] == "C")&#13;
BirtStr.concat(dataSetRow["var_size2"]," CM")&#13;
else&#13;
BirtStr.concat(dataSetRow["var_size2"],'"')</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">size_total</property>
                    <text-property name="displayName">size_total</text-property>
                    <property name="dataType">float</property>
                    <simple-property-list name="aggregateOn">
                        <value>size</value>
                    </simple-property-list>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["weight"]</expression>
                        </structure>
                    </list-property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">pending_total</property>
                    <text-property name="displayName">pending_total</text-property>
                    <property name="dataType">float</property>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["weight"]</expression>
                        </structure>
                    </list-property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">cust_ref</property>
                    <text-property name="displayName">cust_ref</text-property>
                    <expression name="expression" type="javascript">dataSetRow["cust_ref"]</expression>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="name">diffdays</property>
                    <text-property name="displayName">diffdays</text-property>
                    <expression name="expression" type="javascript">BirtDateTime.diffDay(dataSetRow["ordh_sodate"],dataSetRow["stk_ent_date"])</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">customer</property>
                    <text-property name="displayName">customer</text-property>
                    <expression name="expression" type="javascript">"Party : " + row["cust_ref"]</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">party_total</property>
                    <text-property name="displayName">party_total</text-property>
                    <property name="dataType">float</property>
                    <simple-property-list name="aggregateOn">
                        <value>customergrp</value>
                    </simple-property-list>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">row["weight"]</expression>
                        </structure>
                    </list-property>
                    <property name="allowExport">true</property>
                </structure>
                <structure>
                    <property name="name">RunDate</property>
                    <text-property name="displayName">RunDate</text-property>
                    <expression name="expression" type="javascript">Formatter.format(BirtDateTime.today(),"dd/MM/yyyy")</expression>
                    <property name="dataType">string</property>
                    <property name="allowExport">true</property>
                </structure>
            </list-property>
